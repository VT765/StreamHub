NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# MongoDB (must be a replica set — Atlas, or the local one from docker-compose)
DATABASE_URL="mongodb://localhost:27017/streamhub?replicaSet=rs0&directConnection=true"
# Atlas: DATABASE_URL="mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/streamhub?retryWrites=true&w=majority"

# Auth
JWT_SECRET=change-me-to-a-long-random-string
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
TRUSTED_DEVICE_DAYS=30

# Email (Mailpit in dev: UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StreamHub <no-reply@streamhub.local>"
SUPPORT_EMAIL=support@streamhub.local

# Razorpay TEST keys (https://dashboard.razorpay.com/app/keys, Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# Optional SMS sign-in codes via Twilio (free trial texts verified numbers). Leave empty for email-only codes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Downloads
DOWNLOADS_REQUIRE_REGISTERED_DEVICE=false
DUPLICATE_DOWNLOAD_WINDOW_HOURS=24

# Comments: translation (LibreTranslate-compatible; falls back to MyMemory public API)
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
COMMENT_EDIT_WINDOW_MINUTES=15

# Video calling: optional TURN server for strict NATs
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
MEETING_MAX_PARTICIPANTS=8
